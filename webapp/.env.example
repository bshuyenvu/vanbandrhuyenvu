# HUYỀN VŨ VĂN BẢN AI — V10 example environment
# Copy values to /etc/vbhc-web.env on production. Never commit real secrets.

# AI providers
VBHC_AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
VBHC_GEMINI_MODEL=gemini-3.5-flash-lite
VBHC_OPENAI_MODEL=gpt-5.6-luna
VBHC_AI_MAX_OUTPUT_TOKENS=4096

# Web service
VBHC_WEB_HOST=127.0.0.1
VBHC_WEB_PORT=8767

# Authentication — REQUIRED in production, >= 32 random characters
VBHC_SESSION_SECRET=
VBHC_PLATFORM_ADMIN_EMAILS=
VBHC_AUTO_ACTIVATE_FREE=false
VBHC_ALLOW_ANON_AI=false

# Privacy policy
# confidential documents are treated as restricted unless explicitly enabled
VBHC_ALLOW_CONFIDENTIAL_EXTERNAL_AI=false

# Billing / cost guard
VBHC_USD_VND=27000
VBHC_COST_RESERVE=1.10
VBHC_MIN_AI_CREDIT=50

# Manual transfer / future payment adapter
VBHC_PAYMENT_BANK_NAME=
VBHC_PAYMENT_ACCOUNT_NUMBER=
VBHC_PAYMENT_ACCOUNT_NAME=

# Development SQLite path. Production migration target: PostgreSQL schema in webapp/saas/schema.sql
VBHC_DEV_DB=/var/lib/huyen-vu-van-ban-ai/huyenvu-vbai.db

# V10 GitHub-only document storage
VBHC_ENV=production
VBHC_GITHUB_DOCS_REPO=
VBHC_GITHUB_DOCS_BRANCH=documents
VBHC_GITHUB_TOKEN=
VBHC_ALLOW_ANON_ADVANCED=false

# Legacy V2 attachment storage only — not used by AI Word V10 editor
VBHC_FILE_ROOT=
VBHC_REQUIRED_STORAGE_MOUNT=

# Production security limits
VBHC_MAX_REQUEST_BYTES=16777216
VBHC_LOGIN_EMAIL_LIMIT=6
VBHC_LOGIN_IP_LIMIT=30
